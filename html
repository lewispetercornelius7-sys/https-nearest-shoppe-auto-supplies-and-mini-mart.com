html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: #17202a;
  background: #f8fafc;
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}


/* HERO */

.hero {
  min-height: 75vh;
  color: white;

  background:
    linear-gradient(
      rgba(17, 24, 39, 0.90),
      rgba(17, 24, 39, 0.70)
    ),
    url("assets/shop.jpg") center/cover;
}


/* NAVIGATION */

nav {
  max-width: 1100px;
  margin: auto;

  padding: 22px 20px;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 1.2rem;
  font-weight: 800;
}

.nav-links {
  display: flex;
  gap: 25px;
}

.nav-links a:hover {
  color: #f59e0b;
}


/* HERO CONTENT */

.hero-content {
  max-width: 1100px;
  margin: auto;

  padding: 90px 20px;
}

.eyebrow {
  color: #f59e0b;

  font-size: 0.8rem;

  font-weight: 800;

  letter-spacing: 0.15em;
}

h1 {
  max-width: 850px;

  margin: 15px 0;

  font-size: clamp(2.5rem, 7vw, 5rem);

  line-height: 1.05;
}

.hero-content > p:not(.eyebrow) {
  max-width: 650px;

  font-size: 1.15rem;
}


/* BUTTONS */

.buttons {
  display: flex;

  gap: 12px;

  flex-wrap: wrap;

  margin-top: 30px;
}

.button {
  padding: 13px 20px;

  border-radius: 10px;

  font-weight: 800;
}

.call {
  background: #f59e0b;

  color: #111827;
}

.whatsapp {
  background: #16a34a;

  color: white;
}

.button:hover {
  opacity: 0.85;
}


/* SECTIONS */

.section,
.about,
.contact {
  max-width: 1100px;

  margin: auto;

  padding: 80px 20px;
}

h2 {
  font-size: 2.4rem;

  line-height: 1.1;

  margin-top: 8px;

  margin-bottom: 30px;
}


/* PRODUCTS */

.products {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 22px;
}

.product-card {
  background: white;

  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 8px 30px rgba(0, 0, 0, 0.08);
}

.product-card img {
  width: 100%;

  height: 220px;

  object-fit: cover;
}

.product-card h3,
.product-card p {
  margin-left: 20px;

  margin-right: 20px;
}

.product-card h3 {
  font-size: 1.4rem;
}

.product-card p {
  padding-bottom: 20px;
}


/* ABOUT */

.about {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 50px;

  align-items: center;
}

.about-image img {
  width: 100%;

  border-radius: 20px;
}


/* CONTACT */

.contact {
  background: white;
}

.contact-boxes {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 16px;
}

.contact-boxes a {
  padding: 22px;

  border: 1px solid #e5e7eb;

  border-radius: 14px;

  background: white;
}

.contact-boxes strong,
.contact-boxes span {
  display: block;
}

.contact-boxes span {
  margin-top: 5px;

  overflow-wrap: anywhere;
}


/* FOOTER */

footer {
  text-align: center;

  padding: 30px;

  background: #111827;

  color: white;
}


/* MOBILE */

@media (max-width: 750px) {

  .nav-links {
    display: none;
  }

  .hero-content {
    padding-top: 70px;
  }

  .products,
  .about,
  .contact-boxes {
    grid-template-columns: 1fr;
  }

  .section,
  .about,
  .contact {
    padding: 55px 18px;
  }

  h1 {
    font-size: 2.7rem;
  }

}
